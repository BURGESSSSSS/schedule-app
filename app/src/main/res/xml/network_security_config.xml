<?xml version="1.0" encoding="utf-8"?>
<!-- 仅对淘宝系域名放行明文 HTTP：菜鸟 H5 偶尔会 302 到 http 地址。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">taobao.com</domain>
        <domain includeSubdomains="true">tmall.com</domain>
        <domain includeSubdomains="true">cainiao.com</domain>
        <domain includeSubdomains="true">alibaba.com</domain>
        <domain includeSubdomains="true">aliyun.com</domain>
    </domain-config>
</network-security-config>
